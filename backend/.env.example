# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1: Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expensetrackerdb
DB_USER=postgres
DB_PASSWORD=your_password_here

# Option 2: Cloud PostgreSQL (e.g. Neon DB, Supabase, Render)
# If DATABASE_URL is set, it will automatically override local settings above:
# DATABASE_URL=postgresql://user:password@ep-...neon.tech/neondb?sslmode=require

# ==============================================================================
# Groq AI Insights Configuration
# ==============================================================================
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

